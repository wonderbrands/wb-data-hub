# =============================================================================
# TikTok Bulky Fulfillment - variables de entorno
# Copiar como `.env` junto al script (o exportar ENV_PATH apuntando a otro).
# En Kestra estas mismas llaves se inyectan con secret()/vars en el flow.
# =============================================================================

# ---------- Ejecución ----------
LOG_LEVEL=INFO
TIKTOK_BULKY_DRY_RUN=false          # true = cotiza y valida, pero NO genera guías
TEST_API_LABELS_SR=false            # true = usa los endpoints qa_ de la API interna
TIKTOK_BULKY_MAX_ORDERS=0           # 0 = sin límite; útil para el piloto
TIKTOK_BULKY_LOOKBACK_HOURS=72
TIKTOK_BULKY_PAGE_SIZE=50
SLEEP_BETWEEN_ORDERS=3

# ---------- Reglas de negocio ----------
LIMIT_RATIO_PERCENTAGE=0.21
ORIGIN_ZIP=54010
SAT_BIENES_TRANSP=50161815

# ---------- Tiendas Bulky ----------
# El seller_name debe coincidir con somos_reyes.tiktok_shop_tokens.seller_name
TIKTOK_KH_ENABLED=true
TIKTOK_KH_SELLER_NAME=KingsHouse
TIKTOK_KH_APP_KEY=
TIKTOK_KH_APP_SECRET=
TIKTOK_KH_SHOP_CIPHER=

TIKTOK_CDH_ENABLED=true
TIKTOK_CDH_SELLER_NAME=ColorDreams Home
TIKTOK_CDH_APP_KEY=
TIKTOK_CDH_APP_SECRET=
TIKTOK_CDH_SHOP_CIPHER=

# Neon: se enciende cuando la tienda esté lista
TIKTOK_NEON_ENABLED=false
TIKTOK_NEON_SELLER_NAME=Neon
TIKTOK_NEON_APP_KEY=
TIKTOK_NEON_APP_SECRET=
TIKTOK_NEON_SHOP_CIPHER=

# ---------- TikTok (opcional) ----------
# Vacío = no se manda handover_method (algunos shops lo rechazan en self-shipment)
TIKTOK_HANDOVER_METHOD=DROP_OFF

# Cómo reportar la guía: ship (despacha) | shipping_info (corrige) | auto
TIKTOK_SHIP_STRATEGY=auto

# El mapa carrier -> shipping_provider_id ya viene cargado en el config con el
# catálogo real. Sólo se usa si la consulta al catálogo falla. Aquí se extiende:
# TIKTOK_SHIPPING_PROVIDER_IDS={"SEGMAIL":"7208..."}

# Regiones para consultar el catálogo de paqueterías
TIKTOK_WAREHOUSE_REGION=MX

# delivery_option_id fijo, si el descubrimiento automático falla
# TIKTOK_DELIVERY_OPTION_ID=

# false = manda el nombre del estado tal cual (cuando la API interna haga el mapeo)
MAP_STATE_TO_CODE=true

# ---------- API interna de guías (Shipping Routing System) ----------
AUTH_USER=
AUTH_PASS=

# ---------- Odoo 18 ----------
odoo_urlV18=https://somosreyes.odoo.com
odoo_dbV18=
odoo_user_dataV18=
odoo_password_dataV18=

# ---------- MySQL (tokens + tools.shipping_labels) ----------
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=tools

# ---------- Google Sheets ----------
# Contenido JSON de la cuenta de servicio (una sola línea) o ruta al archivo.
GOOGLE_CREDS_JSON=
SPREADSHEET_TIKTOK_ID=1eMbXb_lb8WRYO1jr8jcBnfq495kaLc3Do9Wyf8BxTnM
